[Unit]
Description=RiffPass microservicio %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=riffpass
Group=riffpass
WorkingDirectory=/opt/riffpass
EnvironmentFile=/etc/riffpass/%i.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/riffpass/riffpass-%i-service.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
