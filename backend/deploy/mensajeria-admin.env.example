# Copiar a /etc/riffpass/mensajeria-admin.env y completar. Las credenciales AWS las entrega el rol de la EC2 (LabInstanceProfile).
PORT=8084
SERVER_SERVLET_CONTEXT_PATH=/test
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
AWS_REGION=us-east-1
DECLARAR_TOPOLOGIA=true
CONSUMIDORES_URLS=http://127.0.0.1:8083/test,http://127.0.0.1:8085/test
# Opcional: correo que recibe la alarma de CloudWatch (hay que confirmar la suscripción).
ALARMA_EMAIL=
