# Réplica 2 del consumidor. Copiar a /etc/riffpass/procesamiento-2.env y completar.
# Ambas réplicas usan la misma base: la tabla mensajes_procesados evita procesar dos veces un mensaje.
PORT=8085
INSTANCIA=procesamiento-2
SERVER_SERVLET_CONTEXT_PATH=/test
DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/riffpass_procesamiento?sslmode=verify-full&sslrootcert=/etc/riffpass/global-bundle.pem
DB_USERNAME=riffpass_procesamiento
DB_PASSWORD=REEMPLAZAR_PASSWORD_PROCESAMIENTO
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
AWS_REGION=us-east-1
# true solo para la presentación: habilita los fallos simulados que envía el administrador.
MENSAJERIA_SIMULACION_FALLOS=true
