# Copiar a /etc/riffpass/eventos.env y completar. No activar perfil local en AWS.
PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/test
DB_URL=jdbc:postgresql://REEMPLAZAR_ENDPOINT_RDS:5432/riffpass_eventos?sslmode=verify-full&sslrootcert=/etc/riffpass/global-bundle.pem
DB_USERNAME=riffpass_eventos
DB_PASSWORD=REEMPLAZAR_PASSWORD_EVENTOS
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
CORS_ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=us-east-1
