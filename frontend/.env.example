# Copiar a .env (no se sube a Git) y completar con los valores reales de Cognito.

# Overview del User Pool (riffpass-pool)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# App Client publico/SPA "riffpass-web", sin client secret
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio de login administrado de Cognito, SIN https:// (Branding > Domain del pool)
VITE_COGNITO_DOMAIN=riffpass-xxxxxxx.auth.us-east-1.amazoncognito.com

# Scopes a solicitar en el login (separados por espacio).
# Deben estar habilitados en el App Client. Prefijo real: resource-server-riffpass/
VITE_OAUTH_SCOPES=openid email profile resource-server-riffpass/eventos-read resource-server-riffpass/eventos-write resource-server-riffpass/entradas-read resource-server-riffpass/entradas-write

# A donde vuelve Cognito despues de iniciar/cerrar sesion (deben estar en "Allowed callback/sign-out URLs")
VITE_REDIRECT_SIGNIN=http://localhost:5173/
VITE_REDIRECT_SIGNOUT=http://localhost:5173/

# URL base del API Gateway, stage incluido, SIN "/" final. Vacio = usa el proxy local de Vite.
# Ejemplo: https://abc123.execute-api.us-east-1.amazonaws.com/test
VITE_API_BASE_URL=
