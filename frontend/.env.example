# Copiar a .env (NO se sube a Git) y completar con los datos de tu cuenta AWS
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# URL base del API Gateway (sin "/" final). Vacio = usa el proxy local de Vite.
VITE_API_BASE_URL=
# Token enviado en Authorization: "id" (Cognito authorizer REST) o "access" (JWT authorizer HTTP API)
VITE_TOKEN_TYPE=id
